# ============================================
# UMS IAM Platform - Environment Configuration
# ============================================

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ums_user
MYSQL_PASSWORD=ums_secure_password_change_me
MYSQL_USE_SSL=false

# Service-Specific Database Names
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
AUTHORIZATION_DB_NAME=authorization_db
ORGANIZATION_DB_NAME=organization_db
NOTIFICATION_DB_NAME=notification_db
AUDIT_DB_NAME=audit_db
ADMIN_DB_NAME=admin_db

# ==========================================
# RABBITMQ CONFIGURATION
# ==========================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest_password_change_me

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# SERVICE PORTS
# ==========================================
API_GATEWAY_PORT=8080
DISCOVERY_SERVICE_PORT=8761
CONFIG_SERVICE_PORT=8888
AUTH_SERVICE_PORT=8086
USER_SERVICE_PORT=8081
AUTHORIZATION_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8085
ORGANIZATION_SERVICE_PORT=8087
ADMIN_SERVICE_PORT=8088
AUDIT_SERVICE_PORT=8089

# ==========================================
# JWT CONFIGURATION
# ==========================================
# Generate a fresh RSA key pair and keep the private key outside Git.
# Docker default path: ./secrets/jwt/private_key.pem mounted to /run/secrets/jwt/private_key.pem
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt/private_key.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt/public_key.pem
# Optional for secret managers that inject PEM content directly instead of files.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=ums-iam-platform
JWT_AUDIENCE=
JWT_KEY_ID=local-docker-2026-06-24
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Internal shared secrets must be unique per environment.
INTERNAL_SERVICE_SECRET=change_me_internal_service_secret
INTERNAL_GATEWAY_SECRET=change_me_internal_gateway_secret

# ==========================================
# EMAIL/NOTIFICATION CONFIGURATION
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@umsiam.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL=INFO
SPRING_LOG_LEVEL=INFO

# ==========================================
# SPRING PROFILES & ENVIRONMENT
# ==========================================
SPRING_PROFILES_ACTIVE=docker
ENVIRONMENT=docker
EUREKA_DEFAULT_ZONE=http://discovery-service:8761/eureka/

# ==========================================
# OPENTELEMETRY/OBSERVABILITY
# ==========================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_SAMPLER_ARG=0.1

# ==========================================
# GRAFANA CONFIGURATION
# ==========================================
GRAFANA_ADMIN_PASSWORD=admin_password_change_me

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
APP_NAME=UMS-IAM-Platform
APP_VERSION=1.0.0
TIMEZONE=UTC

# ==========================================
# SECURITY
# ==========================================
# OAuth2 Configuration (if using external providers)
OAUTH2_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH2_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH2_GITHUB_CLIENT_ID=your_github_client_id
OAUTH2_GITHUB_CLIENT_SECRET=your_github_client_secret
