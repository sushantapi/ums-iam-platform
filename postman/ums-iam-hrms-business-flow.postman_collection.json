{
  "info": {
    "_postman_id": "7f8b1b3a-8084-4f1c-95b4-2d8f4a4c4f1d",
    "name": "UMS IAM + HRMS Business Flow",
    "description": "End-to-end Postman collection for the UMS IAM + HRMS platform. Run in order with a seeded admin account that has platform, organization, HRMS, payroll, session and audit permissions. The collection stores IDs from successful responses and reuses them in later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response is not 5xx', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
