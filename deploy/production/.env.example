# Copy to deploy/production/.env on the production host.
# Keep the real file outside Git and chmod 600 it.

COMPOSE_PROJECT_NAME=ums-iam-prod
IMAGE_REGISTRY=ghcr.io/sushantapi/ums-iam-platform
APP_VERSION=

API_DOMAIN=
ACME_EMAIL=
GATEWAY_ALLOWED_ORIGINS=

MYSQL_ROOT_PASSWORD=
MYSQL_USER=ums_app
MYSQL_PASSWORD=
MYSQL_USE_SSL=false
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
AUTHORIZATION_DB_NAME=authorization_db
ORGANIZATION_DB_NAME=organization_db
EMPLOYEE_DB_NAME=employee_db
ATTENDANCE_DB_NAME=attendance_db
LEAVE_DB_NAME=leave_db
PAYROLL_DB_NAME=payroll_db
NOTIFICATION_DB_NAME=notification_db
AUDIT_DB_NAME=audit_db
ADMIN_DB_NAME=admin_db

RABBITMQ_DEFAULT_USER=ums_app
RABBITMQ_DEFAULT_PASS=
REDIS_PASSWORD=

JWT_ISSUER=ums-iam-platform
JWT_AUDIENCE=ums-api-gateway
JWT_KEY_ID=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

INTERNAL_GATEWAY_SECRET=
INTERNAL_SERVICE_SECRET=
MFA_ENCRYPTION_KEY=
MFA_TOTP_ISSUER=UMS IAM

PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_PAGE_URL=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true

LOG_LEVEL=INFO
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:+UseG1GC
